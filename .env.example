# Copy values into your local shell or secret manager. Never commit populated
# credentials. R2_ACCOUNT_ID may replace R2_ENDPOINT_URL.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Runpod provider authentication is read from the shell by Terraform.
RUNPOD_API_KEY=
